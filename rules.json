        "$env:LOCALAPPDATA\\LobsterAI\\logs",
        "$env:LOCALAPPDATA\\LobsterAI\\temp"
      ],
      "note": "来源：LobsterAI 官方手册（数据目录 LobsterAI），Windows 对应 %APPDATA%"
    },
    {
      "name": "卸载残留-有道龙虾",
      "group": "residue",
      "kind": "residue",
      "safe": "安全",
      "desc": "清理网易有道龙虾 LobsterAI 卸载后残留的数据目录与注册表项",
      "exes": [
        "C:\\Program Files\\LobsterAI\\*.exe",
