{
  "schema": 1,
  "version": "2026.11.09",
  "updated": "2026-11-09 20:10",
  "items": [
    {
      "name": "TRAE缓存",
      "group": "cache",
      "kind": "dir",
      "safe": "安全",
      "desc": "清理 TRAE 编辑器的缓存、日志与崩溃转储（AI 对话记录、工作区数据和登录状态不动）",
      "cat": "开发工具",
      "dprobe": "Trae",
      "paths": [
        "$env:APPDATA\\Trae\\Cache",
        "$env:APPDATA\\Trae\\Cache_Data",
        "$env:APPDATA\\Trae\\Code Cache",
        "$env:APPDATA\\Trae\\GPUCache",
        "$env:APPDATA\\Trae\\CachedData",
        "$env:APPDATA\\Trae\\logs",
        "$env:APPDATA\\Trae\\Crashpad",
        "$env:APPDATA\\Trae CN\\Cache",
        "$env:APPDATA\\Trae CN\\Cache_Data",
        "$env:APPDATA\\Trae CN\\Code Cache",
        "$env:APPDATA\\Trae CN\\GPUCache",
        "$env:APPDATA\\Trae CN\\CachedData",
        "$env:APPDATA\\Trae CN\\logs",
        "$env:APPDATA\\Trae CN\\Crashpad"
      ],
      "note": "来源：TRAE 官方文档 %APPDATA%\\Trae（国际版）/ Trae CN（国内版）"
    },
    {
      "name": "卸载残留-TRAE",
      "group": "residue",
      "kind": "residue",
      "safe": "安全",
      "desc": "清理 TRAE 编辑器卸载后残留的数据目录与注册表项（国际版 Trae 与国内版 Trae CN 都覆盖）",
      "exes": [
        "C:\\Program Files\\Trae\\*.exe",
        "C:\\Program Files\\Trae CN\\*.exe",
        "$env:LOCALAPPDATA\\Programs\\Trae\\*.exe",
        "$env:LOCALAPPDATA\\Programs\\Trae CN\\*.exe"
      ],
      "procs": [
        "Trae"
      ],
      "dirs": [
        "C:\\Program Files\\Trae",
        "C:\\Program Files\\Trae CN",
        "$env:LOCALAPPDATA\\Programs\\Trae",
        "$env:LOCALAPPDATA\\Programs\\Trae CN",
        "$env:APPDATA\\Trae",
        "$env:APPDATA\\Trae CN",
        "$env:USERPROFILE\\.trae"
      ],
      "regs": [
        "HKCU:\\Software\\Trae",
        "HKLM:\\SOFTWARE\\Trae",
        "HKLM:\\SOFTWARE\\WOW6432Node\\Trae"
      ],
      "note": "来源：TRAE 官方文档"
    },
    {
      "name": "有道龙虾缓存",
