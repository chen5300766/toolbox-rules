        "D:\\Users\\*\\AppData\\Roaming\\Trae",
        "$env:APPDATA\\Trae CN",
        "C:\\Users\\*\\AppData\\Roaming\\Trae CN",
        "D:\\Users\\*\\AppData\\Roaming\\Trae CN",
        "$env:USERPROFILE\\.trae"
      ],
      "regs": [
        "HKCU:\\Software\\Trae",
        "HKLM:\\SOFTWARE\\Trae",
        "HKLM:\\SOFTWARE\\WOW6432Node\\Trae"
      ],
      "note": "来源：TRAE 官方文档"
