        "$env:LOCALAPPDATA\\Programs\\Trae CN",
        "$env:APPDATA\\Trae",
        "$env:APPDATA\\Trae CN",
        "$env:USERPROFILE\\.trae"
      ],
      "regs": [
        "HKCU:\\Software\\Trae",
        "HKLM:\\SOFTWARE\\Trae",
        "HKLM:\\SOFTWARE\\WOW6432Node\\Trae"
      ],
      "note": "来源：TRAE 官方文档"
