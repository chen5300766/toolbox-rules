        "D:\\Program Files*\\Trae CN\\*.exe",
        "$env:LOCALAPPDATA\\Programs\\Trae\\*.exe",
        "$env:LOCALAPPDATA\\Programs\\Trae CN\\*.exe"
      ],
      "procs": [
        "Trae"
      ],
      "dirs": [
        "C:\\Program Files*\\Trae",
        "D:\\Program Files*\\Trae",
        "C:\\Program Files*\\Trae CN",
        "D:\\Program Files*\\Trae CN",
        "$env:LOCALAPPDATA\\Programs\\Trae",
        "C:\\Users\\*\\AppData\\Local\\Programs\\Trae",
        "D:\\Users\\*\\AppData\\Local\\Programs\\Trae",
        "$env:LOCALAPPDATA\\Programs\\Trae CN",
        "C:\\Users\\*\\AppData\\Local\\Programs\\Trae CN",
        "D:\\Users\\*\\AppData\\Local\\Programs\\Trae CN",
        "$env:APPDATA\\Trae",
