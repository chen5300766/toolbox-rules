    {
      "name": "库库AI缓存",
      "group": "cache",
      "kind": "dir",
      "safe": "安全",
      "desc": "清理库库AI的缓存、日志与临时文件（文档、任务记录和登录状态不动）",
      "cat": "AI工具",
      "dprobe": "KukuAI|库库",
      "paths": [
        "$env:APPDATA\\KukuAI\\Cache",
        "$env:APPDATA\\KukuAI\\logs",
        "$env:APPDATA\\KukuAI\\temp",
        "$env:APPDATA\\KukuAI\\GPUCache",
        "$env:APPDATA\\KukuAI\\Code Cache",
        "$env:LOCALAPPDATA\\KukuAI\\Cache",
        "$env:LOCALAPPDATA\\KukuAI\\logs",
        "$env:LOCALAPPDATA\\KukuAI\\temp",
        "$env:APPDATA\\库库\\Cache",
        "$env:APPDATA\\库库\\logs",
        "$env:LOCALAPPDATA\\库库\\Cache",
        "$env:LOCALAPPDATA\\库库\\logs"
      ],
      "note": "来源：库库AI 为百度文库网盘 GenFlow 独立端；目录按常见安装位置多路覆盖，不存在自动跳过"
    },
    {
      "name": "卸载残留-库库AI",
      "group": "residue",
      "kind": "residue",
      "safe": "安全",
      "desc": "清理库库AI卸载后残留的安装目录、数据目录与注册表项",
      "exes": [
        "C:\\Program Files\\KukuAI\\*.exe",
        "C:\\Program Files\\库库\\*.exe",
        "$env:LOCALAPPDATA\\Programs\\KukuAI\\*.exe",
        "$env:LOCALAPPDATA\\Programs\\库库\\*.exe"
      ],
      "procs": [
        "KukuAI"
      ],
      "dirs": [
        "C:\\Program Files\\KukuAI",
        "C:\\Program Files\\库库",
        "$env:LOCALAPPDATA\\Programs\\KukuAI",
        "$env:LOCALAPPDATA\\Programs\\库库",
        "$env:APPDATA\\KukuAI",
        "$env:APPDATA\\库库",
        "$env:LOCALAPPDATA\\KukuAI",
        "$env:LOCALAPPDATA\\库库"
      ],
      "regs": [
        "HKCU:\\Software\\KukuAI",
        "HKLM:\\SOFTWARE\\KukuAI",
        "HKLM:\\SOFTWARE\\WOW6432Node\\KukuAI"
      ],
      "note": "来源：多路覆盖，路径不存在则跳过"
    },
    {
      "name": "卸载残留-微软OfficePLUS",
      "group": "residue",
      "kind": "residue",
      "safe": "谨慎",
      "desc": "清理微软 OfficePLUS 插件卸载后残留的安装目录（建议先用插件自带的卸载程序，清完重开 Office 生效）",
      "exes": [
        "C:\\Program Files\\MS office plus\\*.exe",
        "C:\\Program Files (x86)\\MS office plus\\*.exe"
      ],
      "procs": [
        "MSOfficePlus"
      ],
      "dirs": [
        "C:\\Program Files\\MS office plus",
        "C:\\Program Files (x86)\\MS office plus"
      ],
      "regs": [],
      "note": "来源：微软社区问答，安装目录 C:\\Program Files\\MS office plus 内含 uninstall 程序"
    }
  ]
